DB_HOST=postgres-pgvector
DB_PORT=5432
DB_USER=pbtien
DB_PASSWORD=change_me
DB_NAME=fashion_db

OBJECT_DETECTION_URL=http://object-detection:8001
OBJECT_DETECTION_MODEL_PATH=/models/object-detection/best.pt
M2_MASK_MODE=off

API_PORT=8000
VITE_API_URL=http://localhost:8000
MATCH_SCORE_THRESHOLD=0.70
MIN_IMAGE_SIMILARITY=0.60
COLOR_BACKFILL_BATCH_SIZE=50
ENABLE_TEXT_STYLE_RERANK=true
RERANK_IMAGE_WEIGHT=0.60
RERANK_CATEGORY_WEIGHT=0.15
RERANK_COLOR_WEIGHT=0.15
RERANK_TEXT_STYLE_WEIGHT=0.10

EMBEDDING_MODEL=patrickjohncyh/fashion-clip
EMBEDDING_VERSION=2

# Official production color path: HSV147 only. Cache is a new sidecar, not RGB fallback.
HSV_CONFIG_PATH=
HSV_COLOR_CACHE_PATH=data/color_cache_hsv147.json
# Host artifact mounted read-only by Docker Compose (set to the newly rebuilt file).
HSV_COLOR_CACHE_FILE=./data/color_cache_hsv147.json
# zero: color contributes 0, weights unchanged; error: reject missing/invalid color.
HSV_MISSING_POLICY=zero

APIFY_API_TOKEN=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
