# Bỏ qua môi trường ảo (Virtual Environment)
venv/
env/
.venv/

# BẢO MẬT TUYỆT ĐỐI: Không đẩy file chứa khóa bí mật và mật khẩu lên mạng
.env

# Bỏ qua thư mục chứa dữ liệu cào được (Tránh làm nặng Git và lộ lịch sử cào)
data/
*.json

# Bỏ qua các file rác của Python trong quá trình biên dịch
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/

# Bỏ qua cấu hình của các IDE (VS Code, PyCharm)
.vscode/
.idea/

# Bỏ qua file log và DB local
*.log
*.sqlite3

# Bỏ qua bộ nhớ đệm của Hugging Face (nếu có tải model thẳng vào thư mục dự án)
.huggingface/
.hf_cache/

# AI model weights stay local
models/
*.pt

# Frontend dependencies/build output
node_modules/
web/fe/node_modules/
web/fe/dist/

# Keep frontend package manifests despite broad *.json data ignore above
!web/fe/package.json
!web/fe/package-lock.json

# Keep evaluation label templates, but ignore generated eval outputs
!evaluation/
!evaluation/labels.example.json
!evaluation/labels.json
!evaluation/labels.real.example.json
!evaluation/labels.real.json
!evaluation/real_outfit_sources.json
!evaluation/labels.starter_catalog.json
!evaluation/queries/
!evaluation/queries/.gitkeep
!evaluation/queries/real_outfits/
!evaluation/queries/real_outfits/.gitkeep
!evaluation/queries/starter_catalog/
evaluation/results/

# Workspace runtimes, extraction tools, and local baseline runs
tmp/
.coverage
htmlcov/
output/m2/runs/

# M2 reproducible contract fixtures and reviewed evidence
!tests/fixtures/m2/*.json
!evaluation/m2/*.json
!docs/m2/phase1/*.json
!docs/m2/phase1/baseline_20261107_cpu/baseline.json
!docs/m2/phase2/*.json
# Reproducible M3 diagnostic reports (separate from production catalogs/caches)
!docs/m3_results/**/report.json
!docs/m3_results/catalog_manifest.json
!docs/m3_results/catalog_color_cache.json

# Shared M3 handoff profile and real-weights verification evidence
!docs/m3_contract/*.json
!docs/m3_handoff_evidence/*.json
!docs/m3_production_evidence/*.json
